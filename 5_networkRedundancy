Config STP path cost method
	Acc4(config)#spanning-tree pathcost method <"short" | "long">	// set pathcost method, must be changed on all switches if changed on one

Verification STP path cost method
	Acc4#show spanning-tree pathcost method				// show STP path cost method of the switch

Config manually set STP path cost
	Acc3(config)#interface f0/2
	Acc3(config-if)#spanning-tree cost <costValue>

Config STP Version
	CD1(config)#spanning-tree mode <"mst" | "pvst" | "rapid-pvst">	// 3 modes: mst, pvst, rapid-pvst; pvst is default

Verification STP
	1. CD1#show spanning-tree summary				// show highly summarised STP configuration
	2. CD1#show spanning-tree					// show spanning tree details for all vlans
	3. CD1#show spanning-tree vlan <vlanNo>				// show spannig tree details for specified vlan
		Output:	1) spanninng tree enabled protocol ieee			// actual protocol used is "cisco pvst ieee" not "ieee"
			2) Root ID						// details of Root Bridge for spanning tree instance of this VLAN
			3) Bridge ID						// details of this switch or spanning tree instance of this VLAN
			4) Interface level STP details - status, role, link cost
	4. CD1#show mac address-table					// path of traffic at layer 2 can be tracked (traffic for which mac is going through which port)

Config explicit Bridge Priority value
	Using keywords
		CD1(config)#spanning-tree vlan 1 root primary		// internally sets Bridge Priority value to 24576; 1st most preferred for Root Bridge

		CD2(config)#spanning-tree vlan 1 root secondary		// internally sets Bridge Priority value to 28672; 2nd most preferred for Root Bridge
	Using exact values
		CD1(config)#spanning-tree vlan 1 priority <priorityValue>

Config aligned HSRP and STP along with load balancing
	> End-users at access layer split into 2 vlans 10 & 20
	> for VLAN 10: R1 HSRP active router, CD1 Root Bridge, R2 HSRP standby router, CD2 2nd preferrence for Root Bridge
	> for VLAN 20: R2 HSRP active router, CD2 Root Bridge, R1 HSRP standby router, CD1 2nd preferrence for Root Bridge
	> Using router on a stick for inter-VLAN routing, instead of router with separate interfaces

	// R1 HSRP active for vlan 10, HSRP standby for vlan 20
	R1(config)#int f0/1.10
	R1(config)#encap dot1q 10
	R1(config-if)#ip address 10.0.10.2 255.255.255.0
	R1(config-if)#no shut
	R1(config-if)#standby 1 10.0.10.1
	R1(config-if)#standby priority 110
	R1(config-if)#standby preempt
	R1(config-if)#end
	R1(config)#int f0/1.20
	R1(config-if)#encap dot1q 20
	R1(config-if)#ip addres 10.0.20.2 255.255.255.0
	R1(config-if)#no shut
	R1(config-if)#standby 2 10.0.20.1
	R1(config-if)#standby priority 90
	R1(config-if)#end
	
	// R2 HSRP active for vlan 20, HSRP standby for vlan 10
	R2(config)#int f0/1.10
	R2(config-if)#encap dot1q 10
	R2(config-if)#ip address 10.0.10.3 255.255.255.0
	R2(config-if)#no shut
	R2(config-if)#standby 1 10.0.10.1
	R2(config-if)#standby priority 90
	R2(config-if)#end
	R2(config)#int f0/1.20
	R2(config-if)#encap dot1q 20
	R2(config-if)#ip address 10.0.20.3 255.255.255.0
	R2(config-if)#no shut
	R2(config-if)#standby 2 10.0.20.1
	R2(config-if)#standby priority 110
	R2(config-if)#standby preempt
	R2(config-if)#end

	// CD1 (directly connected to R1) Root Bridge for vlan 10, 2nd preferred Root Bridge for vlan 20
	CD1(config)#spanning-tree vlan 10 root primary
	CD1(config)#spanning-tree vlan 20 root secondary

	// CD2 (directly connected to R2) Root Bridge for vlan 20, 2nd preferred Root Bridge for vlan 10
	CD2(config)#spanning-tree vlan 10 root secondary
	CD2(config)#spanning-tree vlan 20 root primary

Config Portfast
	Config on access port
	SW1(config-if)#spanning-tree portfast		// enables portfast on this, access, interface

	Config globally
	SW1(config)#spanning-tree portfast default	// enables portfast on all interfaces of the switch

	Config on trunk port
	SW1(config-if)#spanning-tree portfast trunk	// misconfiguration failsafe

Config BPDU Guard along with Portfast
	// local interface config
	SW1(config)#int f0/1
	SW1(config-if)#spanning-tree portfast
	SW1(config-if)#spanning-tree bpduguard enable

	// global switch config
	SW1(config)#spanning-tree portfast bpduguard default

Config automatic error disable recovery from being error disabled by BPDU Guard
	SW1(config)#errdisable recovery cause bpduguard		// set automatic recovery on being error disabled by BPDU Guard
	SW1(config)#errdisable recovery interval <seconds>	// set automatic recovery attempt interval <seconds>s

Config Root Guard
	SW1(config-if)#spanning-tree guard root			// receiving superior BPDUs than current Root will have this port blocked; auto recovery when BPDUs stop coming in

Config BPDU Filter
	> Global config
		SW1(config)#spanning-tree portfast bpdufilter default	// enabled on Portfast enabled interfaces, similar effect to Portfast Edge

	> Interface level config
		SW1(config-if)#spanning-tree bpdufilter enable		// disables STP on this port

Config Loop Guard
	> Config at global-switch level (for all switchports)
	SW1(config)#spanning-tree loopguard default

	> Config at interface level
	SW1(config-if)#spanning-tree guard loop

Verification Portfast, BPDU Guard, Root Guard, BPDU Filter, Loop Guard
	1. SW1#show spanning-tree summary				// shows which all additional STP features are GLOBALLY enabled/disabled
	2. SW1#show spanning-tree interface <intfNo> detail		// shows which all additional STP features are LOCALLY enabled/disabled on this interface

