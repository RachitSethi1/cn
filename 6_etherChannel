Config EtherChannel using EtherChannel Protocols
	1. LACP
		SW1(config)#interface range f0/23 - 24
		SW1(config-if-range)#channel-group 1 mode <'active' | 'passive'>
		SW1(config-if-range)#end

	2. PAGP
		SW1(config)#interface range f0/23 - 24
		SW1(config-if-range)#channel-group 1 mode <'desirable' | 'auto'>
		SW1(config-if-range)#end

	3. Static setup
		SW1(config)#interface range f0/23 - 24
		SW1(config-if-range)#channel-group 1 mode on
		SW1(config-if-range)#end

	// Additional interface configurations on created PortChannel
		SW1(config)#interface port-channel 1
		SW1(config-if)#switchport mode trunk

Verification EtherChannel
	1. SW1#show etherchannel summary		// shows summary of status and details for all portchannels on switch
	2. SW1#show etherchannel			// verbose output
	3. SW1#show spanning-tree vlan <vlanNo.>	// stp will see a single logical port instead of separate individual physical ports => stp will not block those ports anymore

Config Layer 3 Etherchannel on a Layer 3 Switch
	SW1(config)#interface range f0/23 - 24				// select interface range
	SW1(config-if-range)#no switchport				// convert to lyer 3 ports
	SW1(config-if-range)#channel-group 1 mode <intfChannelMode>	// create etherchannel
	SW1(config-if-range)#end
	SW1(config)#interface port-channel 1				// enter interface config for etherchannel
	SW1(config-if)#ip address 192.168.0.1 255.255.255.252		// add ip address on this logical layer 3 port
	SW1(config-if)#no shutdown					// to bring thus layer 3 port up