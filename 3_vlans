-------------------------------------------------------------------------------------VLANS_LAB---------------------------------------------------------------------------------------
Config Vlan
	SW1(config)#vlan <vlanNo>
	SW1(config-vlan)#name <anyName>						// optionally name identification

Config Access Port
	SW1(config-if)#switchport mode access					// config interface as access port
	SW1(config-if)#switchport access vlan <vlanNo>				// config access port to vlan vlanNo

Verification Vlan
	1. SW1#show vlan brief							// global vlan details
	2. SW1#show interface <intfNo> switchport				// switchport & vlan details for specific interface

Config Trunk Ports
	SW1(config-if)#switchport trunk encapsulation dot1q			// set trunking protocol to dot1q from ISL (cisco proprietary, obsolete) before config as trunk port
	SW1(config-if)#switchport mode trunk					// set interface to trunk port

Config Native Vlan
	SW1(config)#vlan <anyUnusedVlanNoEg199>					// native vlan must match on both sides of link for trunk link to come up
	SW1(config-vlan)#name Native
	SW1(config-vlan)#end
	SW1(config)#interface FastEthernet 0/0
	SW1(config-if)#switchport trunk encapsulation dot1q
	SW1(config-if)#switchport mode trunk
	SW1(config-if)#switchport trunk native vlan <vlanNo>

Config Allowed Vlans List on Trunk Port
	SW1(config-if)#switchport trunk allowed vlan 10,30,40			// limits traffic to only the mentioned vlans

Config DTP
	SW1(config-if)#switchport mode dynamic <desirable|auto>			// config switchport using DTP
				OR
	SW1(config-if)#switchport nonegotiate					// disable DTP

Config VTP
	SW1(config)#vtp domain <domainName>					// set vtp domain on switch
	SW1(config)#vtp mode <server|client|transparent>			// set vtp mode for switch
	SW1(config)#vlan 20							// configure vlans (for vtp servers and vtp transparents)
	SW1(config-vlan)#name sales

Verification VTP
	1. SW1#show vtp status							// show vtp status for the switch

Inter-VLAN Routing
	1. Router with separate interfaces
		// configure interfaces on router
		R1(config)#int f0/1
		R1(config-if)#ip addr 10.0.10.1 255.255.255.0
		R1(config-if)# no shut
		R1(config-if)#int f0/2
		R1(config-if)#ip addr 10.0.20.1 255.255.255.0
		R1(config-if)#no shut
		R1(config-if)#end
		R1(config)#ip route 0.0.0.0 0.0.0.0 203.0.113.2

		// configure vlans on switch
		SW1(config)#vlan 10
		SW1(config-vlan)#name Eng
		SW1(config-vlan)#vlan 20
		SW1(config-vlan)#name Sales
		SW1(config)#end

		// add interfaces to vlans
		SW1(config)#int f0/1
		SW1(config-if)#switchport mode access
		SW1(config-if)#switchport access vlan 10
		SW1(config-if)#int f0/2
		SW1(config-if)#switchport mode access
		SW1(config-if)#switchport access vlan 20

	2. Router on a stick:
		R1(config)#int f0/1
		R1(config-if)#no ip addr					// remove any ip address previously set on physical interface
		R1(config-if)#no shut
		R1(config-if)#int f0/1.10					// virtual sub-interface FastEthernet 0/1.10
		R1(config-if)#encap dot1q 10					// frame with dot1q tag as 10 should hit this virtual sub-interface
		R1(config-if)#ip addr 10.0.10.1 255.255.255.0			// set ip address on sub-interface
		R1(config-if)#end
		R1(config)#int f0/1.20						// virtual sub-interface FastEthernet 0/1.20
		R1(config-if)#encap dot1q 20					// frame with dot1q tag as 20 should hit this virtual sub-interface
		R1(config-if)#ip addr 10.0.20.1 255.255.255.0			// add ip address on sub-interface
		R1(config-if)#end
		R1(config)#ip route 0.0.0.0 0.0.0.0 203.0.113.2			// deafult static route for external WAN connectivity

		SW1(config)#vlan 199
		SW1(config-vlan)#name native
		SW1(config-vlan)#end
		SW1(config)#int f0/1
		SW1(config-if)#switchport trunk encap dot1q
		SW1(config-if)#switchport mode trunk				// set port to router as trunk
		SW1(config-if)#switchport trunk native vlan 199

	3. Layer 3 switch:
		// configure SVIs
		SW1(config)#ip routing						// enable ip routing
		SW1(config)#interface vlan 10					// create an SVI for vlan 10
		SW1(config-if)#ip address 10.0.10.1 255.255.255.0		// add ip address on SVI, default gateway for vlan 10
		SW1(config-if)#no shut
		SW1(config)#interface vlan 20					// create SVI for vlan 20
		SW1(config-if)#ip address 10.0.20.1 255.255.255.0		// add ip address on SVI, default gateway for vlan 20
		SW1(config-if)#no shut

		// configure interface as routerport for external WAN connectivity
		SW1(config)#int f0/1						// interface connecting the WAN edge router
		SW1(config-if)#no switchport					// config port as layer 3 port
		SW1(config-if)#ip address 10.0.100.1 255.255.255.0		// add ip address on port
		SW1(config-if)#no shut
		SW1(config-if)#end
		SW1(config)#ip route 0.0.0.0 0.0.0.0 10.0.100.2			// add default static route on switch